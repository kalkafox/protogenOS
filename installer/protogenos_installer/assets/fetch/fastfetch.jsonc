// protogenOS system-wide fastfetch configuration.
// Copy to ~/.config/fastfetch/config.jsonc to customize it for one user.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/protogenos/fastfetch-logo.txt",
        "color": {
            "1": "38;2;255;64;92",
            "2": "38;2;245;241;242"
        }
    },
    "display": {
        "color": {
            "keys": "38;2;255;64;92",
            "title": "38;2;255;64;92"
        }
    },
    // fastfetch's default modules; a config without this list shows only the logo.
    "modules": [
        "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
        "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
        "terminal", "terminalfont", "cpu", "gpu", "memory", "swap", "disk",
        "localip", "battery", "poweradapter", "locale", "break", "colors"
    ]
}
