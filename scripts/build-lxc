#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image_name="${PROTOGENOS_BUILDER_IMAGE:-protogenos-archiso-builder}"
arch_image="${PROTOGENOS_ARCH_IMAGE:-archlinux:base}"
# Shared with docker-build so ISO and LXC builds reuse downloaded packages.
pacman_cache="${PROTOGENOS_PACMAN_CACHE:-${XDG_CACHE_HOME:-${HOME}/.cache}/protogenos/pacman-pkg}"

if ! command -v docker >/dev/null 2>&1; then
    echo "Docker was not found." >&2
    exit 1
fi

if [[ -n "$(docker images -q "${image_name}" 2>/dev/null)" && "${PROTOGENOS_FORCE_BUILD:-}" != "1" ]]; then
    echo "Image ${image_name} already exists; skipping build (set PROTOGENOS_FORCE_BUILD=1 to rebuild)."
else
    docker build \
        --build-arg "ARCH_IMAGE=${arch_image}" \
        --tag "${image_name}" \
        --file "${project_root}/docker/Dockerfile" \
        "${project_root}"
fi

mkdir -p "${pacman_cache}"

# pacstrap mounts /proc, /sys and /dev inside the new root, so the builder
# needs --privileged, exactly like the ISO build.
docker run --rm --privileged \
    --env "HOST_UID=$(id -u)" \
    --env "HOST_GID=$(id -g)" \
    --mount "type=bind,src=${project_root},dst=/workspace" \
    --mount "type=bind,src=${pacman_cache},dst=/var/cache/pacman/pkg" \
    "${image_name}" \
    /workspace/scripts/container-build-lxc
