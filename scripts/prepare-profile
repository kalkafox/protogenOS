#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_profile="/usr/share/archiso/configs/releng"
target_profile="${PROTOGENOS_PROFILE_DIR:-${project_root}/profile}"

if [[ ! -d "${source_profile}" ]]; then
    echo "Archiso's releng profile was not found." >&2
    echo "Install it on Arch Linux with: sudo pacman -S archiso" >&2
    exit 1
fi

if [[ -e "${target_profile}" ]]; then
    echo "${target_profile} already exists; leaving it unchanged." >&2
    echo "Move it aside if you want to prepare a fresh profile." >&2
    exit 1
fi

cp -a "${source_profile}" "${target_profile}"
cp -a "${project_root}/overlays/airootfs/." "${target_profile}/airootfs/"
printf '\nsource /usr/local/share/protogenos/zlogin\n' \
    >> "${target_profile}/airootfs/root/.zlogin"

# Ship the installer in a stable location so the live-session command works.
install -d \
    "${target_profile}/airootfs/opt/protogenos/installer" \
    "${target_profile}/airootfs/opt/protogenos/profiles" \
    "${target_profile}/airootfs/opt/protogenos/scripts" \
    "${target_profile}/airootfs/usr/local/bin"
cp -a "${project_root}/installer/." \
    "${target_profile}/airootfs/opt/protogenos/installer/"
cp -a "${project_root}/profiles/." \
    "${target_profile}/airootfs/opt/protogenos/profiles/"
install -m 0755 "${project_root}/scripts/protogenos-install" \
    "${target_profile}/airootfs/opt/protogenos/scripts/protogenos-install"
ln -s /opt/protogenos/scripts/protogenos-install \
    "${target_profile}/airootfs/usr/local/bin/protogenos-install"
install -m 0755 "${project_root}/scripts/protogenos-install-web" \
    "${target_profile}/airootfs/opt/protogenos/scripts/protogenos-install-web"
ln -s /opt/protogenos/scripts/protogenos-install-web \
    "${target_profile}/airootfs/usr/local/bin/protogenos-install-web"

# Build and ship the web GUI's static assets, unless explicitly skipped for
# local CLI/TUI-only iteration on a machine without bun installed.
if [[ "${PROTOGENOS_SKIP_FRONTEND_BUILD:-}" != "1" ]]; then
    "${project_root}/scripts/build-frontend"
    install -d "${target_profile}/airootfs/opt/protogenos/installer-web/dist"
    cp -a "${project_root}/installer-web/dist/." \
        "${target_profile}/airootfs/opt/protogenos/installer-web/dist/"
else
    echo "PROTOGENOS_SKIP_FRONTEND_BUILD=1: skipping web GUI build; the GUI" >&2
    echo "installer will be unavailable on this profile (TUI still works)." >&2
fi

# Keep the installer's live-environment dependencies explicit instead of
# depending on the current contents of Archiso's releng package list.
# cage/firefox/seatd/mesa/curl back the web GUI installer; mesa provides the
# llvmpipe software rasterizer so it still renders under VM display devices
# (virtio-gpu, QXL, VMware, VirtualBox) with no 3D acceleration exposed. It
# falls back to the TUI below (via protogenos-install-web's own checks, and
# zlogin's boot-cmdline override) on machines with no DRM device at all.
for package in python arch-install-scripts dosfstools e2fsprogs parted \
    cage firefox seatd mesa curl; do
    if ! grep -qxF "${package}" "${target_profile}/packages.x86_64"; then
        printf '%s\n' "${package}" >> "${target_profile}/packages.x86_64"
    fi
done

# cage gets DRM/input access through this seatd instance (or logind). Don't
# wrap cage in seatd-launch: it refuses to start while this service owns
# /run/seatd.sock, which silently dropped every boot back to the TUI.
install -d "${target_profile}/airootfs/etc/systemd/system/multi-user.target.wants"
ln -sf /usr/lib/systemd/system/seatd.service \
    "${target_profile}/airootfs/etc/systemd/system/multi-user.target.wants/seatd.service"

# Keep upstream boot mechanics while making every visible entry clearly ours.
while IFS= read -r -d '' boot_config; do
    sed -i \
        -e 's/Arch Linux install medium/protogenOS Live Environment/g' \
        -e 's/Arch Linux Installation Medium/protogenOS Live Environment/g' \
        -e 's/Arch Linux/protogenOS/g' \
        "${boot_config}"
done < <(find \
    "${target_profile}/efiboot" \
    "${target_profile}/grub" \
    "${target_profile}/syslinux" \
    -type f -print0 2>/dev/null)

"${project_root}/scripts/add-installer-boot-entries" "${target_profile}"

profile_definition="${target_profile}/profiledef.sh"
sed -i \
    -e 's/^iso_name=.*/iso_name="protogenos"/' \
    -e 's/^iso_label=.*/iso_label="PROTO_$(date --date="@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y%m)"/' \
    -e 's|^iso_publisher=.*|iso_publisher="protogenOS Project"|' \
    -e 's|^iso_application=.*|iso_application="protogenOS Live/Installation Media"|' \
    -e 's/^install_dir=.*/install_dir="protogenos"/' \
    -e '/^file_permissions=(/a\  ["/opt/protogenos/scripts/protogenos-install"]="0:0:755"' \
    -e '/^file_permissions=(/a\  ["/opt/protogenos/scripts/protogenos-install-web"]="0:0:755"' \
    "${profile_definition}"

# Downloads dominate cold builds; releng ships only 5 parallel downloads.
sed -i 's/^ParallelDownloads = .*/ParallelDownloads = 15/' \
    "${target_profile}/pacman.conf"

# xz squashfs compression is the slowest step of a warm build. zstd trades a
# somewhat larger ISO for a much faster build; keep xz for releases.
if [[ "${PROTOGENOS_FAST_BUILD:-}" == "1" ]]; then
    sed -i \
        "s/^airootfs_image_tool_options=.*/airootfs_image_tool_options=('-comp' 'zstd' '-Xcompression-level' '3' '-b' '1M')/" \
        "${profile_definition}"
    echo "PROTOGENOS_FAST_BUILD=1: compressing airootfs with zstd instead of xz." >&2
fi

echo "Prepared Archiso profile at ${target_profile}"
