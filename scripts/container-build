#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_root="$(mktemp -d /tmp/protogenos-build.XXXXXXXX)"

build_root_mounts() {
    findmnt -rn -o TARGET | grep -F -- "${build_root}/" | sort -r || true
}

cleanup() {
    # mkarchiso normally removes its own work directory after a successful
    # build. Only remove our exact temporary directory after checking it.
    [[ "${build_root}" == /tmp/protogenos-build.* ]] || return 0

    # An interrupted build leaves the airootfs chroot mounts in place. Its
    # /dev is the kernel's shared devtmpfs, so deleting through it removes
    # the host's device nodes. Detach every mount first, deepest first.
    local mountpoint
    while IFS= read -r mountpoint; do
        umount --lazy -- "${mountpoint}" || true
    done < <(build_root_mounts)
    if [[ -n "$(build_root_mounts)" ]]; then
        echo "Leaving ${build_root} in place: filesystems are still mounted under it." >&2
        return 0
    fi
    rm -rf --one-file-system -- "${build_root}"
}
trap cleanup EXIT

# The builder image is cached between runs, so its archiso releng profile
# (and keyring) goes stale as Arch drops/renames packages. Refresh them
# before copying releng, otherwise mkarchiso fails with "target not found".
sed -i 's/^#\?ParallelDownloads = .*/ParallelDownloads = 15/' /etc/pacman.conf
pacman -Syu --noconfirm --needed archiso archlinux-keyring

export PROTOGENOS_PROFILE_DIR="${build_root}/profile"
export PROTOGENOS_WORK_DIR="${build_root}/work"
export PROTOGENOS_OUTPUT_DIR="${build_root}/out"

"${project_root}/scripts/prepare-profile"
"${project_root}/scripts/build-iso"

mkdir -p "${project_root}/out"
find "${project_root}/out" -maxdepth 1 -type f \
    \( -name '*.iso' -o -name 'SHA256SUMS' \) -delete
cp -f "${PROTOGENOS_OUTPUT_DIR}"/*.iso "${project_root}/out/"
(
    cd "${project_root}/out"
    sha256sum ./*.iso > SHA256SUMS
)

# Bind-mounted outputs otherwise belong to root on the host. CI does not need
# this, but it keeps local Docker builds convenient.
if [[ -n "${HOST_UID:-}" && -n "${HOST_GID:-}" ]]; then
    chown "${HOST_UID}:${HOST_GID}" \
        "${project_root}/out" \
        "${project_root}/out"/*.iso \
        "${project_root}/out/SHA256SUMS"
fi

echo "ISO artifacts and checksums copied to ${project_root}/out"
